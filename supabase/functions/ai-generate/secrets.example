# Copy to supabase/.env.ai.local (gitignored), enter NEW keys, then upload only
# that file to Supabase. Do not put these values in Vercel or an EXPO_PUBLIC_ var.
GEMINI_API_KEY=replace_with_new_private_key
GEMINI_FLASH_MODEL=gemini-3.5-flash-lite
GEMINI_PRO_MODEL=gemini-3.5-flash-lite
GEMINI_COACH_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: retain the existing generation fallback. Omit if not configured.
GROQ_API_KEY=replace_with_new_private_groq_key_or_remove_this_line
GROQ_MODEL=llama-3.3-70b-versatile
AI_ALLOWED_ORIGINS=https://gbombs.app,https://www.gbombs.app
